RAYFLOW_ENV=production
RAYFLOW_STORAGE_DIR=/data
AI_PROVIDER=local
# Leave optional providers unset until configured by the operator.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
PIXABAY_API_KEY=
# Use an address reachable from the backend container on a private network.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_ALLOWED_HOSTS=
OLLAMA_GENERATION_TIMEOUT=180
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_HOME=/models/huggingface
MAX_UPLOAD_MB=500
MAX_REQUEST_MB=1024
RENDER_CONCURRENCY=1
RENDER_QUEUE_LIMIT=4
RENDER_TIMEOUT_SECONDS=1800
# Same-origin Caddy deployment needs no cross-origin browser access.
CORS_ORIGINS=
