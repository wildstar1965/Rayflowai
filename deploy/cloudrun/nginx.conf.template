# Rendered by the nginx:alpine entrypoint via envsubst. ${PORT} and ${BACKEND_URL}
# are supplied by Cloud Run. Serves the SPA and proxies /api to the backend.
server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Security headers (kept lightweight; the backend sets its own API headers).
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    client_max_body_size 1024m;

    # Reverse-proxy the API to the backend Cloud Run service. Credentials and
    # cookies flow through; long timeouts accommodate planning/transcription.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 620s;
        proxy_send_timeout 620s;
    }

    # SPA routing: fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache built, fingerprinted assets aggressively.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
