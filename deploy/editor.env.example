# Backend only. Configure these in Render, never in VITE_* variables.
RAYFLOW_ENV=production
RAYFLOW_STORAGE_DIR=/tmp/rayflow
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-service-role-key
RAYFLOW_VAULT_SECRET=replace-with-at-least-32-random-characters
RAYFLOW_PUBLIC_ORIGINS=https://your-rayflow.vercel.app
CORS_ORIGINS=https://your-rayflow.vercel.app
RAYFLOW_FRONTEND_URL=https://your-rayflow.vercel.app
EDITOR_BACKEND_PUBLIC_URL=https://rayflow-ai-api.onrender.com
EDITOR_JOB_CONCURRENCY=2
EDITOR_QUEUE_LIMIT=4
EDITOR_GLOBAL_QUEUE_LIMIT=32
EDITOR_JOB_TIMEOUT_SECONDS=1800
EDITOR_LIVE_CONCURRENCY=4
EDITOR_OUTPUT_MAX_MB=256
RENDER_CONCURRENCY=1
# Additional exact CDN hostnames (comma-separated), only when your provider uses them.
EDITOR_RUNWAY_OUTPUT_HOSTS=
EDITOR_WORLDLABS_OUTPUT_HOSTS=

# Optional services reachable from the backend. Never put a judge's localhost here.
EDITOR_OLLAMA_URL=
EDITOR_LMSTUDIO_URL=
EDITOR_OPENAI_COMPATIBLE_URL=
EDITOR_COMFYUI_URL=
# Additional audited ComfyUI node class names, comma-separated. Empty keeps the built-in allowlist.
EDITOR_COMFYUI_EXTRA_NODES=
EDITOR_DRAW_THINGS_URL=
# Collaboration uses the authenticated FastAPI relay and durable Supabase records.
EDITOR_NOTEBOOKLM_URL=
# These are paths INSIDE the backend image/server, with separately installed dependencies/weights.
EDITOR_SURFACE_MAP_REPO=
EDITOR_CORRIDOR_KEY_REPO=

# Optional cloud sync applications; provider credentials stay encrypted backend-side.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
