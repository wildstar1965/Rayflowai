# RayFlow AI — production environment reference (Google Cloud Run).
#
# This file documents the variable NAMES and safe placeholder values only.
# NEVER commit real secrets. In production these are provided by Google Secret
# Manager (see --set-secrets in cloudbuild.yaml) and plain env vars via
# --set-env-vars. Do not put secret VALUES in this file or in cloudbuild.yaml.

# ---- Core runtime --------------------------------------------------------
RAYFLOW_ENV=production
# Cloud Run gives the container an ephemeral /tmp; persistent media lives in GCS.
RAYFLOW_STORAGE_DIR=/tmp/rayflow
# Cloud Run injects PORT automatically; do not hardcode it.

# ---- Google Cloud --------------------------------------------------------
GCP_PROJECT_ID=ladysingham
GCP_REGION=asia-south1
# GCS bucket for uploads/projects/exports/thumbnails (must be private).
GCS_BUCKET=rayflow-storage-ladysingham
# Optional object-name prefix inside the bucket.
GCS_PREFIX=
# Name of the Cloud Run Job that renders exports. When set, the backend
# dispatches rendering to the job instead of rendering in-process.
RENDER_CLOUD_RUN_JOB=rayflow-render

# ---- Secrets (provided via Secret Manager; names only here) --------------
# Qloo hackathon API key (backend-only, never exposed to the browser).
QLOO_API_KEY=__set_in_secret_manager__
# Optional override; defaults to the hackathon base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Database / record + blob store (existing Supabase architecture).
SUPABASE_URL=__set_in_secret_manager__
SUPABASE_SERVICE_ROLE_KEY=__set_in_secret_manager__

# Encryption key for provider credentials stored per workspace.
RAYFLOW_VAULT_SECRET=__set_in_secret_manager__

# ---- Optional AI providers (Studio Director / Taste Intelligence LLM) -----
# Any ONE of these enables the LLM path; otherwise the rule-based taste engine
# and manual editing continue to work with no key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=

# ---- Optional media services ---------------------------------------------
PIXABAY_API_KEY=

# ---- Networking / CORS ----------------------------------------------------
# The frontend proxies /api to the backend same-origin, so CORS is usually not
# needed. If calling the backend cross-origin, list allowed origins here.
CORS_ORIGINS=
RAYFLOW_PUBLIC_ORIGINS=
RAYFLOW_FRONTEND_URL=

# ---- Concurrency / limits -------------------------------------------------
RENDER_CONCURRENCY=1
RENDER_QUEUE_LIMIT=4
RENDER_TIMEOUT_SECONDS=1800
MAX_UPLOAD_MB=500
MAX_REQUEST_MB=1024
