    "mammoth": "1.11.0",
    "pdfjs-dist": "4.10.38",
    "react-markdown": "9.1.0",
    "reactflow": "11.11.4",
    "three": "0.166.1",
    "yjs": "13.6.30",
    "@designcodeio/threeui": "file:vendor/threeui",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "gsap": "^3.15.0",
    "lucide-react": "^1.58.0",
