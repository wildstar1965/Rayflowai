    "lint": "oxlint",
    "test": "node --test ../tests/test_caption_engine.mjs ../tests/test_reference_features.mjs ../tests/test_subtitle_timeline.mjs ../tests/test_timeline_correctness.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
