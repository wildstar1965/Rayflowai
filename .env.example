# RayFlow AI Environment Configuration
RAYFLOW_ENV=development
# Optional; relative paths resolve under backend/. Production requires a mounted path.
RAYFLOW_STORAGE_DIR=
AI_PROVIDER=auto
# Frontend variables belong in frontend/.env.local (see frontend/.env.example).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Put credentials in backend/.env. Never prefix secrets with VITE_.
PIXABAY_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_ALLOWED_HOSTS=
OLLAMA_GENERATION_TIMEOUT=180
WHISPER_MODEL=medium
WHISPER_LOCAL_ONLY=true
WHISPER_DEVICE=auto
# Leave unset to use float16 on CUDA and int8 on CPU.
# WHISPER_COMPUTE_TYPE=int8
# Optional override; RVM is discovered automatically after --video-matting setup.
PERSON_SEGMENTATION_MODEL=
PERSON_SEGMENTATION_PROVIDER=CPUExecutionProvider
PERSON_MASK_MAX_SIDE=960
PERSON_INFERENCE_MAX_SIDE=960
MAX_UPLOAD_MB=500
MAX_REQUEST_MB=1024
RENDER_CONCURRENCY=1
RENDER_QUEUE_LIMIT=4
RENDER_TIMEOUT_SECONDS=1800
CORS_ORIGINS=
