# RayFlow AI Environment Configuration
HOST=127.0.0.1
PORT=8000
VITE_API_URL=http://localhost:8000/api

# Put credentials in backend/.env. Never prefix secrets with VITE_.
PIXABAY_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
WHISPER_MODEL=base
WHISPER_LOCAL_ONLY=true
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional override; RVM is discovered automatically after --video-matting setup.
PERSON_SEGMENTATION_MODEL=
PERSON_SEGMENTATION_PROVIDER=CPUExecutionProvider
PERSON_MASK_MAX_SIDE=960
PERSON_INFERENCE_MAX_SIDE=960
MAX_UPLOAD_MB=500
