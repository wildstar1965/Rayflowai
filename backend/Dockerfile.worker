# Rendering worker image for Google Cloud Run Jobs.
# Reuses the exact backend runtime (FFmpeg, fonts, Python deps, editor runtime)
# but runs the one-shot render-job entrypoint instead of the web server.
FROM node:24-bookworm-slim AS editor-runtime
WORKDIR /runtime
COPY backend/editor-runtime/package*.json ./
RUN npm ci --omit=dev
COPY backend/editor-runtime/ ./

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/requirements.txt backend/constraints.txt ./
RUN python -m pip install -r requirements.txt -c constraints.txt
COPY backend/app ./app
COPY backend/assets ./assets
COPY backend/setup_local_assets.py ./
COPY --from=editor-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=editor-runtime /runtime ./editor-runtime
RUN useradd --create-home --uid 10001 rayflow && mkdir -p /data /models \
    && chown rayflow:rayflow /data /models
USER rayflow
ENV RAYFLOW_ENV=production RAYFLOW_STORAGE_DIR=/tmp/rayflow HF_HOME=/models/huggingface \
    FFPROBE_PATH=/usr/bin/ffprobe IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
# Cloud Run Jobs run to completion; there is no port or healthcheck.
ENTRYPOINT ["python", "-m", "app.worker.render_job"]
